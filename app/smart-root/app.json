{
  "expo": {
    "owner": "k_chihogi",
    "name": "Smart Root",
    "slug": "smart-root",
    "version": "3.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon_B.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash_D.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kchihogi.smartroot"
    },
    "android": {
      "package": "com.kchihogi.smartroot",
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon_B.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1b78ab5b-7b20-4758-b224-793e2489ac54"
      }
    },
    "plugins": [
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ]
  }
}
